{
  "experiment": {
    "name": "sict_shufflenet_row_anchor_baseline",
    "seed": 42,
    "output_dir": "experiments",
    "device": "cuda"
  },
  "camera": {
    "input_width": 640,
    "input_height": 480,
    "channels": 3
  },
  "roi": {
    "y_min": 200,
    "y_max": 470,
    "x_min": 0,
    "x_max": 640
  },
  "model": {
    "name": "shufflenet_v2_x0_5",
    "pretrained": true,
    "input_channels": 3,
    "input_height": 288,
    "input_width": 384,
    "num_row_anchors": 18,
    "num_spatial_bins": 100,
    "num_absence_classes": 1
  },
  "sict": {
    "enabled": true,
    "gamma_lum": 220.0,
    "delta_spec": 0.05,
    "alpha": 0.6,
    "beta": 0.4,
    "epsilon": 1e-05,
    "ambient_ratio": 0.2,
    "frame_avg_mode": "raw_intensity",
    "out_channels": 3
  },
  "training": {
    "optimizer": "AdamW",
    "beta1": 0.9,
    "beta2": 0.999,
    "weight_decay": 0.0001,
    "initial_lr": 0.004,
    "final_lr": 1e-05,
    "scheduler": "cosine_annealing",
    "batch_size": 32,
    "max_epochs": 50,
    "num_workers": 0
  },
  "loss": {
    "focal_gamma": 2.0,
    "lambda_smooth": 0.5,
    "lambda_curv": 0.75
  },
  "dataset": {
    "synthetic_target_total": 6000,
    "synthetic_train_count": 4200,
    "synthetic_val_count": 900,
    "synthetic_test_count": 900,
    "real_world_target_total": 1000,
    "waypoint_tolerance_px": 7.5,
    "eval_tolerance_px": 8.0,
    "max_trajectory_attempts": 50,
    "max_frame_attempts": 10,
    "min_visible_anchors_trajectory": 3
  }
}